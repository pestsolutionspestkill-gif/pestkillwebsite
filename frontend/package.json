{
  "name": "pest-kill-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test:e2e": "node --test --test-concurrency=1 \"e2e/**/*.e2e.mjs\"",
    "lint": "eslint src scripts e2e",
    "test:unit": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "lenis": "^1.3.27",
    "lucide-react": "^1.77.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.14.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "playwright-core": "^1.65.1",
    "vite": "^7.3.8"
  }
}
