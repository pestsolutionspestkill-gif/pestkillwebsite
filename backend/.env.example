PORT=5000
# Login-token signing key: a long random value (at least 32 characters). Never reuse an example value.
# If empty, a random key is generated once and stored in the database.
JWT_SECRET=

# PostgreSQL connection string (e.g. free Neon database: neon.tech → Connection string).
# Leave empty for local development: an embedded Postgres is stored in ~/.pestkill/pglite
# (outside the project so OneDrive/Dropbox can't lock it). PGLITE_DIR overrides the location.
DATABASE_URL=

# Comma-separated list of website origins allowed to call the API (production domain here)
CLIENT_ORIGIN=http://localhost:3000
# Set to 1 when running behind a reverse proxy (Nginx, Render, Railway) so rate limiting sees real IPs
TRUST_PROXY=

# Optional Owner login (handy on hosts without a shell, e.g. Render). While OWNER_EMAIL and
# OWNER_PASSWORD are set, that account always exists as an Owner and OWNER_PASSWORD always works;
# change the value and restart to change the password. Password: at least 8 characters.
OWNER_NAME=
OWNER_EMAIL=
OWNER_PHONE=
OWNER_PASSWORD=

# Email OTP at sign-up (free with Gmail): Google Account → Security → 2-Step Verification → App passwords.
# Without these, local development shows the code on screen; the live site refuses sign-ups until set.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: any other SMTP server instead of Gmail
# SMTP_HOST=  SMTP_PORT=465  SMTP_USER=  SMTP_PASS=  MAIL_FROM="PestKill Pest Solutions <you@example.com>"
# EMAIL_OTP=off disables the email code (not recommended). EMAIL_CHECK_MX=on checks email domains locally too.

# Search engines. SITE_URL is the one public address of the website (no trailing slash); sitemap,
# canonical links and redirects from other hosts (e.g. *.onrender.com) use it.
# SITE_URL=https://www.your-domain.in
# GOOGLE_SITE_VERIFICATION=   (Search Console → HTML tag → the content="..." value)
# BING_SITE_VERIFICATION=

# PestKill AI (optional). Without a key, /pestkill-ai still offers price estimates and verified
# knowledge search, and says that AI answers are off. Keep the key on the server only.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5           (default)
# AI_EFFORT=medium                   (low | medium | high)
# AI_DAILY_LIMIT_VISITOR=25  AI_DAILY_LIMIT_USER=80  AI_DAILY_LIMIT_STAFF=300
