PORT=5000
# Generate a long random value (at least 32 characters). Never reuse an example value.
JWT_SECRET=

# PostgreSQL connection string (e.g. free Neon database: neon.tech → Connection string).
# Leave empty for local development: an embedded Postgres is stored in backend/data/pglite.
DATABASE_URL=

# Comma-separated list of website origins allowed to call the API (production domain here)
CLIENT_ORIGIN=http://localhost:3000
# Set to 1 when running behind a reverse proxy (Nginx, Render, Railway) so rate limiting sees real IPs
TRUST_PROXY=

# Optional: creates the first Owner account on start-up if none exists (handy on hosts without a shell).
# Remove OWNER_PASSWORD after the first successful start.
OWNER_NAME=
OWNER_EMAIL=
OWNER_PHONE=
OWNER_PASSWORD=
